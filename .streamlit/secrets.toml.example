# Copia este archivo como secrets.toml y rellena el valor.
# secrets.toml está en .gitignore: nunca se versiona.
#
# Al publicar la aplicación, este valor se configura en el panel del servicio en lugar
# de subir el archivo: en Streamlit Community Cloud, en Settings, Secrets; en Posit
# Connect Cloud y en la mayoría del resto, como variable de entorno con este mismo
# nombre. La aplicación busca en los dos sitios.

# Clave compartida del proyecto, para que cualquiera pueda probar el asistente
# sin registrarse. Ponle un límite de gasto en el panel del proveedor: esa es la
# protección real, no el tope por sesión que aplica la aplicación.
DEEPSEEK_API_KEY = "sk-..."
